{
  "title": "Load Shedding and Dependency Resilience",
  "uid": "load-shed",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "title": "Offered rate by priority", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "sum by (priority) (rate(load_shed_admission_requests_total{decision=\"offered\"}[$__rate_interval]))", "legendFormat": "{{priority}}"}]},
    {"id": 2, "title": "Admitted rate by priority", "type": "timeseries", "gridPos": {"x": 8, "y": 0, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "sum by (priority) (rate(load_shed_admission_requests_total{decision=\"admitted\"}[$__rate_interval]))", "legendFormat": "{{priority}}"}]},
    {"id": 3, "title": "Shed rate by priority", "type": "timeseries", "gridPos": {"x": 16, "y": 0, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "sum by (priority) (rate(load_shed_admission_requests_total{decision=\"shed\"}[$__rate_interval]))", "legendFormat": "{{priority}}"}]},
    {"id": 13, "title": "Completed rate by priority and outcome", "type": "timeseries", "gridPos": {"x": 0, "y": 7, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "sum by (priority, outcome) (rate(load_shed_completed_requests_total[$__rate_interval]))", "legendFormat": "{{priority}} {{outcome}}"}]},
    {"id": 4, "title": "Shed fraction", "type": "timeseries", "gridPos": {"x": 8, "y": 7, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "sum(rate(load_shed_admission_requests_total{decision=\"shed\"}[$__rate_interval])) / sum(rate(load_shed_admission_requests_total{decision=\"offered\"}[$__rate_interval]))"}]},
    {"id": 5, "title": "/client p95 and p99 latency", "type": "timeseries", "gridPos": {"x": 16, "y": 7, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(load_shed_http_request_duration_seconds_bucket{route=\"/client\"}[$__rate_interval])))", "legendFormat": "p95"}, {"refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(load_shed_http_request_duration_seconds_bucket{route=\"/client\"}[$__rate_interval])))", "legendFormat": "p99"}]},
    {"id": 6, "title": "Upstream p95 and p99 latency", "type": "timeseries", "gridPos": {"x": 0, "y": 14, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(load_shed_upstream_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95"}, {"refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(load_shed_upstream_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99"}]},
    {"id": 7, "title": "Upstream outcomes", "type": "timeseries", "gridPos": {"x": 8, "y": 14, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(load_shed_upstream_requests_total[$__rate_interval]))", "legendFormat": "{{outcome}}"}]},
    {"id": 8, "title": "Breaker state and transitions", "type": "timeseries", "gridPos": {"x": 16, "y": 14, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "max by (pod) (load_shed_circuit_breaker_state)", "legendFormat": "{{pod}} state"}, {"refId": "B", "expr": "sum by (pod, to_state) (rate(load_shed_circuit_breaker_transitions_total[$__rate_interval]))", "legendFormat": "{{pod}} to {{to_state}}/s"}]},
    {"id": 9, "title": "In-flight requests and limits per pod", "type": "timeseries", "gridPos": {"x": 0, "y": 21, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "max by (pod) (load_shed_admitted_inflight)", "legendFormat": "{{pod}} in-flight"}, {"refId": "B", "expr": "max by (pod, kind) (load_shed_admission_limit)", "legendFormat": "{{pod}} {{kind}} limit"}]},
    {"id": 10, "title": "HPA CPU utilization per API pod", "type": "timeseries", "gridPos": {"x": 8, "y": 21, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "100 * sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"load-shed\",pod=~\"load-shed-api-.*\",container=\"api\"}[$__rate_interval])) / sum by (pod) (kube_pod_container_resource_requests{namespace=\"load-shed\",pod=~\"load-shed-api-.*\",container=\"api\",resource=\"cpu\",unit=\"core\"})", "legendFormat": "{{pod}}"}]},
    {"id": 12, "title": "HPA replica count", "type": "timeseries", "gridPos": {"x": 16, "y": 21, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"load-shed\",horizontalpodautoscaler=\"load-shed-api\"}", "legendFormat": "current"}, {"refId": "B", "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"load-shed\",horizontalpodautoscaler=\"load-shed-api\"}", "legendFormat": "desired"}, {"refId": "C", "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"load-shed\",horizontalpodautoscaler=\"load-shed-api\"}", "legendFormat": "maximum"}]},
    {"id": 11, "title": "Memory per API pod", "type": "timeseries", "gridPos": {"x": 0, "y": 28, "w": 8, "h": 7}, "targets": [{"refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"load-shed\",pod=~\"load-shed-api-.*\",container=\"api\"})", "legendFormat": "{{pod}}"}]}
  ]
}
